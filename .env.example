# PassDrop 配置文件示例
# 复制此文件为 .env 并根据需要修改

# 站点标题（可选）：留空则按页面语言自动显示本地化标题；设置后所有语言统一使用该标题
SITE_TITLE=

# 默认语言（zh / en / ja）：访问者未通过 ?lang=、Cookie 或浏览器语言匹配到支持的语言时使用
DEFAULT_LANG=zh

# 站点对外访问域名/URL (用于生成直达提取分享链接)
BASE_URL=https://passdrop.tmhcorps.cn

# 默认密码有效期（小时），默认 2 小时
DEFAULT_EXPIRE_HOURS=2

# 默认密码最大提取次数，默认 1 次
DEFAULT_MAX_VIEWS=1

# 自动生成密码的默认长度（默认 16 位）
PASSWORD_LENGTH=16

# 数据库存储路径 (Docker 容器内默认使用 /data/passdrop.db)
DATABASE_PATH=./data/passdrop.db

# 服务监听端口与主机
HOST=0.0.0.0
PORT=8000
